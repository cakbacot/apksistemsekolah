	<parameter name="bulan" class="java.lang.Integer"/>
	<parameter name="tahun" class="java.lang.Integer"/>
	<parameter name="logo" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[$P{REPORT_CLASS_LOADER}.getResourceAsStream("logoSekolah.png")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    p.tgl_pelanggaran,
    s.nisn,
    s.nama,
    k.kelas,
    p.kategori_pelanggaran,
    p.keterangan
FROM tbl_pelanggaran p
JOIN tbl_siswa s ON p.nisn = s.nisn
JOIN tbl_kelas k ON s.kelas = k.id_kelas
WHERE MONTH(p.tgl_pelanggaran) = $P{bulan}
  AND YEAR(p.tgl_pelanggaran) = $P{tahun}
ORDER BY p.tgl_pelanggaran, k.kelas, s.nama]]>
	</queryString>
	<field name="tgl_pelanggaran" class="java.lang.Object"/>
	<field name="nisn" class="java.lang.Object"/>
