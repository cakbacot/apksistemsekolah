<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reportGuruprib" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="31ff6287-ea02-4d16-9328-693d616230f3">
	<property name="ireport.zoom" value="1.1269722013523664"/>
	<property name="ireport.x" value="20"/>
	<property name="ireport.y" value="0"/>
	<parameter name="logo" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[$P{REPORT_CLASS_LOADER}.getResourceAsStream("resource/logosekolah.jpeg")]]></defaultValueExpression>
	</parameter>
	<parameter name="paramKdGuru" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    g.kd_guru,
    g.nip_g,
    g.nama,
    CAST(COALESCE(SUM(CASE WHEN a.kehadiran = 1 THEN 1 ELSE 0 END), 0) AS SIGNED) AS total_hadir,
    CAST(COALESCE(SUM(CASE WHEN a.kehadiran = 0 AND a.id_absen IS NOT NULL THEN 1 ELSE 0 END), 0) AS SIGNED) AS total_tidak_hadir,
    COUNT(a.id_absen) AS total_hari_kerja,
    ROUND(
        COALESCE(
            (SUM(CASE WHEN a.kehadiran = 1 THEN 1 ELSE 0 END) * 100.0) / NULLIF(COUNT(a.id_absen), 0),
            0
        ), 2
    ) AS persentase_kehadiran
FROM guru g
LEFT JOIN tbl_absen_guru a ON g.kd_guru = a.kd_guru
WHERE g.nip_g = $P{paramKdGuru}
GROUP BY g.kd_guru, g.nip_g, g.nama]]>
	</queryString>
	<field name="kd_guru" class="java.lang.String"/>
	<field name="nip_g" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="total_hadir" class="java.lang.Long"/>
	<field name="total_tidak_hadir" class="java.lang.Long"/>
	<field name="total_hari_kerja" class="java.lang.Long"/>
	<field name="persentase_kehadiran" class="java.math.BigDecimal"/>
