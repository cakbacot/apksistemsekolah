<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="31ff6287-ea02-4d16-9328-693d616230f3">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="paramKdGuru" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    a.kd_guru,
    g.nama,
    COUNT(a.id_absen) AS total_hari_kerja,
    ROUND((SUM(CASE WHEN a.kehadiran = 1 THEN 1 ELSE 0 END) / COUNT(a.id_absen)) * 100, 2) AS persentase_kehadiran
FROM tbl_absen_guru a
JOIN guru g ON a.kd_guru = g.kd_guru
WHERE g.nip_g = $P{paramKdGuru}
GROUP BY a.kd_guru, g.nama]]>
	</queryString>
	<field name="kd_guru" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="total_hari_kerja" class="java.lang.Long"/>
	<field name="persentase_kehadiran" class="java.math.BigDecimal"/>
