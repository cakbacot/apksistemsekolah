<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="reportSiswa" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="6686fa3d-c74e-4f38-9633-2330b361876f">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="logo" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[$P{REPORT_CLASS_LOADER}.getResourceAsStream("resource/logosekolah.jpeg")]]></defaultValueExpression>
	</parameter>
	<parameter name="paramIdGuru" class="java.lang.String"/>
	<parameter name="paramKelas" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
    s.nisn,
    s.nama AS nama_siswa,
    k.kelas AS kelas,
    CAST(COALESCE(SUM(CASE WHEN a.status_hadir = 1 THEN 1 ELSE 0 END), 0) AS SIGNED) AS jumlah_hadir,
    CAST(COALESCE(SUM(CASE WHEN a.status_hadir = 0 AND a.id_absen IS NOT NULL THEN 1 ELSE 0 END), 0) AS SIGNED) AS jumlah_tidak_hadir,
    COUNT(a.id_absen) AS total_pertemuan,
    ROUND(
        COALESCE(
            (SUM(CASE WHEN a.status_hadir = 1 THEN 1 ELSE 0 END) * 100.0) / NULLIF(COUNT(a.id_absen), 0), 
            0
        ), 1
    ) AS persentase_kehadiran,
    g.nama AS nama_guru,
    g.nip_g AS nip_guru,
    CASE
        WHEN k.kd_guru = g.kd_guru THEN CONCAT('Wali Kelas ', k.kelas)
        ELSE 'Guru Pengampu'
    END AS jabatan_guru
FROM tbl_siswa s
INNER JOIN tbl_kelas k ON s.kelas = k.id_kelas
LEFT JOIN tbl_absen a ON s.nisn = a.nisn
CROSS JOIN (
    SELECT kd_guru, nip_g, nama 
    FROM guru 
    WHERE nip_g = $P{paramIdGuru} 
) g
WHERE k.kelas = $P{paramKelas}
GROUP BY s.nisn, s.nama, k.kelas, k.kd_guru, g.kd_guru, g.nama, g.nip_g
ORDER BY s.nama ASC]]>
	</queryString>
	<field name="nisn" class="java.lang.String"/>
	<field name="nama_siswa" class="java.lang.String"/>
	<field name="kelas" class="java.lang.String"/>
	<field name="jumlah_hadir" class="java.lang.Long"/>
	<field name="jumlah_tidak_hadir" class="java.lang.Long"/>
	<field name="total_pertemuan" class="java.lang.Long"/>
	<field name="persentase_kehadiran" class="java.math.BigDecimal"/>
	<field name="nama_guru" class="java.lang.String"/>
	<field name="nip_guru" class="java.lang.String"/>
	<field name="jabatan_guru" class="java.lang.String"/>
