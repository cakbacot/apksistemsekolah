	<queryString>
		<![CDATA[SELECT
     tbl_transaksi.`no_transaksi` ,
     tbl_transaksi.`nisn` AS nisn,
     tbl_transaksi.`jumlah_bayar`,
     tbl_transaksi.`bulan_bayar`,
     tbl_transaksi.`tahun_bayar`,
     tbl_siswa.`nisn`,
     tbl_siswa.`nama`,
     tbl_siswa.`angkatan`,
     tbl_siswa.`jurusan`,
     tbl_siswa.`kelas`,
     tbl_siswa.`jkel`
FROM
     `tbl_siswa` tbl_siswa INNER JOIN `tbl_transaksi` tbl_transaksi ON tbl_siswa.`nisn` = tbl_transaksi.`nisn`]]>
	</queryString>
