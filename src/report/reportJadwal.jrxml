	<property name="ireport.y" value="0"/>
	<queryString>
		<![CDATA[SELECT
     tbl_jadwal.`id_mapel` AS tbl_jadwal_id_mapel,
     tbl_jadwal.`nama_mapel` AS tbl_jadwal_nama_mapel,
     guru.`nama` AS guru_nama,
     tbl_jadwal.`jam` AS tbl_jadwal_jam,
     tbl_kelas.`kelas` AS nama_kelas
FROM
     `tbl_jadwal` tbl_jadwal 
     LEFT JOIN `guru` guru ON tbl_jadwal.`kd_guru` = guru.`kd_guru`
     LEFT JOIN `tbl_kelas` tbl_kelas ON tbl_jadwal.`kelas` = tbl_kelas.`id_kelas`]]>
	</queryString>
	<field name="tbl_jadwal_id_mapel" class="java.lang.String"/>
	<field name="tbl_jadwal_nama_mapel" class="java.lang.String"/>
	<field name="guru_nama" class="java.lang.String"/>
	<field name="tbl_jadwal_jam" class="java.sql.Time"/>
	<field name="nama_kelas" class="java.lang.String"/>
