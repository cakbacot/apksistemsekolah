	<queryString>
		<![CDATA[SELECT
     guru.`nip_g` AS guru_nip_g,
     guru.`kd_guru` AS guru_kd_guru,
     guru.`nama` AS guru_nama,
     guru.`password` AS guru_password,
     guru.`tgl_lahir` AS guru_tgl_lahir,
     guru.`alamat` AS guru_alamat,
     guru.`no_telp` AS guru_no_telp,
     guru.`jkel` AS guru_jkel,
     guru.`keahlian` AS guru_keahlian
FROM
     `guru` guru]]>
