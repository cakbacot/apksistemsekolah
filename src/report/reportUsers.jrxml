	<parameter name="logo" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[$P{REPORT_CLASS_LOADER}.getResourceAsStream("logosekolah.jpeg")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
     users.`nip` AS users_nip,
     users.`nama` AS users_nama,
     CASE 
         WHEN users.`lvl` = '1' THEN 'Kepala Administrasi'
         WHEN users.`lvl` = '2' THEN 'Admin'
         WHEN users.`lvl` = '3' THEN 'Staff Keuangan'
         ELSE 'Lainnya'
     END AS users_lvl
FROM
     `users` users]]>
	</queryString>
	<field name="users_nip" class="java.lang.String"/>
	<field name="users_nama" class="java.lang.String"/>
	<field name="users_lvl" class="java.lang.String"/>
