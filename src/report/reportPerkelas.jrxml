	<parameter name="logo" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[$P{REPORT_CLASS_LOADER}.getResourceAsStream("logoSekolah.png")]]></defaultValueExpression>
	</parameter>
	<parameter name="kelas" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua Kelas"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    k.kelas,
    s.nisn,
    s.nama,
    s.jkel,
    p.tgl_pelanggaran,
    p.kategori_pelanggaran,
    p.keterangan
FROM tbl_pelanggaran p
INNER JOIN tbl_siswa s ON p.nisn = s.nisn
INNER JOIN tbl_kelas k ON s.kelas = k.id_kelas
WHERE ($P{kelas} = 'Semua Kelas' OR k.kelas = $P{kelas} OR s.kelas = $P{kelas})
ORDER BY k.kelas, p.tgl_pelanggaran, s.nama]]>
	</queryString>
	<field name="kelas" class="java.lang.String"/>
	<field name="nisn" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="jkel" class="java.lang.String"/>
	<field name="tgl_pelanggaran" class="java.lang.String"/>
	<field name="kategori_pelanggaran" class="java.lang.String"/>
	<field name="keterangan" class="java.lang.String"/>
