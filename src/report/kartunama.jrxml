	<parameter name="nisn" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
    s.nisn, 
    s.nama, 
    s.jurusan, 
    k.kelas AS nama_kelas
FROM tbl_siswa s
JOIN tbl_kelas k ON s.kelas = k.id_kelas
WHERE s.nisn = $P{nisn}]]>
	</queryString>
	<field name="nisn" class="java.lang.String">
