	<queryString>
		<![CDATA[SELECT 
    s.nisn, 
    s.nama, 
    COALESCE(s.jurusan, '-') AS jurusan, 
    COALESCE(k.kelas, s.kelas, '-') AS nama_kelas
FROM tbl_siswa s
LEFT JOIN tbl_kelas k ON s.kelas = k.id_kelas
WHERE s.nisn = $P{nisn}]]>
	</queryString>
