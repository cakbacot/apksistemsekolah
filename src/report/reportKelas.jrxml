	<queryString>
		<![CDATA[SELECT
     tbl_kelas.`kelas` AS tbl_kelas_kelas,
     guru.`nip_g` AS guru_nip_g,
     guru.`nama` AS guru_nama,
     guru.`keahlian` AS guru_keahlian
FROM
     `guru` guru 
     INNER JOIN `tbl_kelas` tbl_kelas ON guru.`kd_guru` = tbl_kelas.`kd_guru`]]>
	</queryString>
	<field name="tbl_kelas_kelas" class="java.lang.String"/>
