<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report name" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="38e1a44c-8e18-47ce-a162-3fb8a86adddf">
	<property name="ireport.zoom" value="1.1"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<subDataset name="New Dataset 1" uuid="16a91dfd-33c1-4f2d-a224-f719c9617ff2">
		<queryString language="SQL">
			<![CDATA[SELECT 
    u.nip, 
    u.nama,
    -- 1. Mengubah angka lvl menjadi nama jabatan
    CASE 
        WHEN u.lvl = '1' THEN 'TU'
        WHEN u.lvl = '2' THEN 'Administrasi'
        ELSE '-'
    END AS jabatan,
    -- 2. Mengubah status Y/T menjadi Aktif/Tidak Aktif
    CASE 
        WHEN u.status = 'Y' THEN 'Aktif'
        ELSE 'Tidak Aktif'
    END AS status_teks,
    -- 3. Menghitung persentase kehadiran berdasarkan angka 1 di kolom kehadiran
    ROUND(
        COALESCE(
            (COUNT(CASE WHEN a.kehadiran = 1 THEN 1 END) * 100) / NULLIF(COUNT(a.id_absen), 0), 
            0
        ), 1
    ) AS persentase_kehadiran
FROM users u
LEFT JOIN tbl_absen_user a ON u.nip = a.nip
GROUP BY u.nip, u.nama, u.lvl, u.status;
]]>
		</queryString>
	</subDataset>
	<queryString>
		<![CDATA[SELECT 
    u.nip, 
    u.nama,
    -- 1. Mengubah angka lvl menjadi nama jabatan
    CASE 
        WHEN u.lvl = '1' THEN 'TU'
        WHEN u.lvl = '2' THEN 'Administrasi'
        ELSE '-'
    END AS jabatan,
    -- 2. Mengubah status Y/T menjadi Aktif/Tidak Aktif
    CASE 
        WHEN u.status = 'Y' THEN 'Aktif'
        ELSE 'Tidak Aktif'
    END AS status_teks,
    -- 3. Menghitung persentase kehadiran berdasarkan angka 1 di kolom kehadiran
    ROUND(
        COALESCE(
            (COUNT(CASE WHEN a.kehadiran = 1 THEN 1 END) * 100) / NULLIF(COUNT(a.id_absen), 0), 
            0
        ), 1
    ) AS persentase_kehadiran
FROM users u
LEFT JOIN tbl_absen_user a ON u.nip = a.nip
GROUP BY u.nip, u.nama, u.lvl, u.status;
]]>
	</queryString>
