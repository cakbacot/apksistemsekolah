	<parameter name="nis" class="java.lang.String"/>
	<parameter name="logo" class="java.io.InputStream">
		<defaultValueExpression><![CDATA[$P{REPORT_CLASS_LOADER}.getResourceAsStream("logoSekolah.png")]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    s.nisn,
    s.nama,
    s.jkel,
    k.kelas,
    p.tgl_pelanggaran,
    p.kategori_pelanggaran,
    p.keterangan
FROM tbl_siswa s
LEFT JOIN tbl_kelas k ON s.kelas = k.id_kelas
LEFT JOIN tbl_pelanggaran p ON p.nisn = s.nisn
WHERE s.nisn = $P{nis}
ORDER BY p.tgl_pelanggaran]]>
	</queryString>
	<field name="nisn" class="java.lang.Object"/>
	<field name="nama" class="java.lang.Object"/>
